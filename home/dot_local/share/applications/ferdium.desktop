[Desktop Entry]
Name=Ferdium
Exec=/usr/bin/ferdium --enable-features=AcceleratedVideoDecodeLinuxGL,AcceleratedVideoDecodeLinuxZeroCopyGL,VaapiOnNvidiaGPUs %U
Terminal=false
Type=Application
Icon=ferdium
StartupWMClass=ferdium
Comment=Desktop app bringing all your messaging services into one installable
MimeType=x-scheme-handler/ferdium;
Categories=Network;InstantMessaging;
